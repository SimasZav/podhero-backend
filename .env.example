# PodHero Environment Variables
# Copy this to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key  # use service key for the worker (bypasses RLS)

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM=digest@yourdomain.com            # must be a verified domain in Resend

# Podcast Index API (free at podcastindex.org)
PODCAST_INDEX_KEY=your-api-key
PODCAST_INDEX_SECRET=your-api-secret

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173           # update for production
